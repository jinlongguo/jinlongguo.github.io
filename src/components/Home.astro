---
import Base from '../layouts/Base.astro';
import Project from './Project.astro';
import ArticleList from './ArticleList.astro';
import { getCollection } from 'astro:content';
import { copy, path, type Language } from '../lib/site';
const { lang } = Astro.props as { lang: Language };
const t = copy[lang];
const articles = (await getCollection('articles', ({data}) => !data.draft && data.lang === lang)).sort((a,b) => b.data.date.getTime() - a.data.date.getTime()).slice(0,5);
---
<Base lang={lang}>
  <section class="intro"><p class="eyebrow">JINLONG GUO</p><h1>Knowledge<br />Reconstruction<span>知识重构者</span></h1><p class="lede">{t.intro}</p></section>
  <Project lang={lang} />
  <section class="latest"><div class="section-heading"><h2>{t.latest}</h2><a href={path(lang, 'articles')}>{t.all}</a></div><ArticleList articles={articles} lang={lang} /></section>
</Base>
